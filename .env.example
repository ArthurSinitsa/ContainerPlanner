# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# Django (обязательно сгенерируй новый ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your-secret-key-here

# Список разрешённых хостов через запятую (IP сервера или домен)
# Пример: 192.168.1.100,myserver.local
DJANGO_ALLOWED_HOSTS=*

# Список разрешённых CORS origins через запятую (URL фронтенда в продакшн)
# Пример: http://192.168.1.100,http://myserver.local
CORS_ALLOWED_ORIGINS=

# PostgreSQL
DB_NAME=logistics_db
DB_USER=postgres
DB_PASSWORD=change_me_strong_password

# Grafana
GF_ADMIN_PASSWORD=change_me_strong_password