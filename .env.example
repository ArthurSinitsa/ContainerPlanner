# Скопируй этот файл в .env и заполни значения
# cp .env.example .env
#
# Переменные без значения по умолчанию (DJANGO_SECRET_KEY, DB_PASSWORD,
# GF_ADMIN_PASSWORD) обязательны — без них docker-compose не стартует.

# ── Django ────────────────────────────────────────────────────────────────
# Обязательно сгенерируй новый ключ:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Список разрешённых хостов через запятую (IP сервера или домен)
# Пример: 192.168.1.100,myserver.local
DJANGO_ALLOWED_HOSTS=*

# Дополнительные CORS origins через запятую (URL фронтенда в продакшене).
# localhost:5173 и localhost:8000 уже разрешены в settings.py.
# Пример: http://192.168.1.100,http://myserver.local
CORS_ALLOWED_ORIGINS=

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_NAME=logistics_db
DB_USER=postgres
DB_PASSWORD=change_me_strong_password

# Хост БД. В docker-compose подставляется автоматически (db), задавать здесь
# нужно только при локальном запуске Django вне контейнеров.
# DB_HOST=127.0.0.1

# ── Redis / Celery ────────────────────────────────────────────────────────
# Брокер и backend результатов Celery. В docker-compose подставляется
# автоматически (redis://redis:6379/0); задавать здесь нужно только при
# локальном запуске воркера вне контейнеров.
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Хранение файлов ───────────────────────────────────────────────────────
# Через сколько дней celery-beat удаляет исходные файлы заявок и
# сгенерированные .xlsx с раскладкой (по умолчанию 30).
# Раскладка после удаления будет собрана заново при следующем скачивании.
FILE_RETENTION_DAYS=30

# ── Grafana ───────────────────────────────────────────────────────────────
GF_ADMIN_PASSWORD=change_me_strong_password

# ── Фронтенд ──────────────────────────────────────────────────────────────
# Внимание: этот файл фронтенд не читает. Vite подхватывает переменные из
# frontend/.env на этапе сборки, туда нужен адрес бэкенда:
# VITE_API_BASE_URL=http://localhost:8000
# В docker-compose фронт ходит в API через nginx-прокси (/api/), поэтому
# переменную можно оставить пустой.
